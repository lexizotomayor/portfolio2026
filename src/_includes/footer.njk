<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-left">
      <p class="footer-name">{{ site.name }}</p>
      <p class="footer-copy">&copy; {{ page.date.getFullYear() if page.date else "2026" }} {{ site.name }}. All rights reserved.</p>
    </div>

    <div class="footer-social">
      <a href="{{ site.social.github }}" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
        GitHub
      </a>
      <a href="{{ site.social.linkedin }}" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
        LinkedIn
      </a>
      <a href="{{ site.social.twitter }}" target="_blank" rel="noopener noreferrer" aria-label="Twitter/X">
        Twitter
      </a>
    </div>

    <div class="footer-right">
      <p class="footer-built">Built with <a href="https://www.11ty.dev/" target="_blank" rel="noopener noreferrer">11ty</a></p>
    </div>
  </div>
</footer>
