---
layout: base.njk
---
<article class="post">
  {% if image %}<img class="post-hero" src="{{ image }}" alt="">{% endif %}
  <div class="post-category"><a href="/blog/">Journal</a></div>
  <h1 class="post-title">{{ title }}</h1>
  <div class="post-meta">
    <span>by <strong>{{ site.name }}</strong></span>
    <span>&middot;</span>
    <span>{{ date | dateReadable }}</span>
  </div>
  <div class="prose">{{ content | safe }}</div>
</article>
