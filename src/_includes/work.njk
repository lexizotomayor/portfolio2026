---
layout: base.njk
navActive: /portfolio/
---
<article>
  <p class="article__back"><a href="/portfolio/">&larr; portfolio</a></p>

  {% if image %}
  <figure class="article__hero">
    <img src="{{ image }}" alt="{{ title }}">
  </figure>
  {% endif %}

  <div class="rule rule--heavy article__rule" aria-hidden="true"></div>

  <div class="article__meta">
    <div class="article__stamp">
      {% if category %}<span class="article__ago">{{ category }}</span>{% endif %}
      <time class="article__date" datetime="{{ page.date | htmlDateString }}">{{ page.date | dateReadable }}</time>
    </div>
    <div>
      <h1 class="article__title">{{ title }}</h1>
      {% if description %}<p class="article__standfirst">{{ description }}</p>{% endif %}
      {% if projectUrl %}<p class="article__cta"><a class="btn" href="{{ projectUrl }}" rel="noopener">view project <span aria-hidden="true">&rarr;</span></a></p>{% endif %}
    </div>
  </div>

  <div class="prose">{{ content | safe }}</div>

  <div class="pagefoot">
    <a class="btn" href="/portfolio/"><span aria-hidden="true">&larr;</span> all work</a>
  </div>
</article>
