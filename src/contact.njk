---
layout: base.njk
nav: contact
title: Contact
permalink: /contact/
---
<section class="page-header teal">
  <h1>Get in touch</h1>
  <p>{{ home.contactPageIntro }} 
    <a href="mailto:{{ site.email }}">{{ site.email }}</a>.</p>
</section>
<section class="contact-grid">
  <div>
    <h2>Let's talk</h2>
    <div class="contact-method"><div class="label">EMAIL</div><a href="mailto:{{ site.email }}">{{ site.email }}</a></div>
    <div class="contact-method"><div class="label">ROLES</div><div>{{ site.tagline }}</div></div>
  </div>
  <form class="contact-form">
    <label>Name<input type="text" name="name"></label>
    <label>Email<input type="email" name="email"></label>
    <label>Message<textarea name="message" rows="4"></textarea></label>
    <button type="submit" class="btn">Send message &rarr;</button>
  </form>
</section>
