---
layout: base.njk
nav: home
title: Lexi Zotomayor
---
<section class="hero">
  <div class="hero-portrait-wrap">
    <img class="hero-portrait" src="/img/uploads/cna-profile.jpg" alt="Illustrated portrait of Lexi in scrubs">
  </div>
  <div class="hero-text">
    <div class="hero-greeting">
      {% for line in home.heroGreeting %}<div>{{ line }}</div>{% endfor %}
    </div>
    <div class="hero-caption-group">
      <div class="hero-caption">{{ home.heroCaption }}</div>
      <div class="hero-script">{{ home.heroScript }}</div>
    </div>
  </div>
</section>

<section class="work-history">
  <div class="work-history-text">
    <h2>{{ home.workHistoryHeading }}</h2>
    <h3>{% for line in home.workHistoryLines %}{{ line }}<br>{% endfor %}</h3>
    <div class="rule"></div>
    <p>{{ home.bio }}</p>
  </div>
  <div class="clippings">
    <img class="clip clip-big" src="/img/uploads/island%20locator_feb%20cover.png" alt="Magazine cover">
    <div class="clip-side">
      <img class="clip" src="/img/uploads/BOOK5-min.png" alt="Book cover">
      <div class="clip-row">
        <img class="clip" src="/img/uploads/IMG_5364.png" alt="Clipping">
        <img class="clip" src="/img/uploads/IMG_5369.png" alt="Clipping">
      </div>
      <div class="clip-row">
        <img class="clip" src="/img/uploads/IMG_5370.png" alt="Clipping">
        <img class="clip" src="/img/uploads/GuamDailyPost-dentalmodification.png" alt="Clipping">
      </div>
    </div>
  </div>
</section>

<section class="skills">
  <div class="skills-heading"><h2>Skills</h2><div class="rule"></div></div>
  <div class="skills-grid">
    {% for s in home.skills %}
    <div class="skill">
      <div class="skill-title">{{ s.title }}</div>
      <p>{{ s.description }}</p>
    </div>
    {% endfor %}
  </div>
</section>

<section class="contact-cta">
  <h2>Get in touch</h2>
  <p>{{ home.contactIntro }}</p>
  <a class="btn pill" href="/contact/">&rarr; {{ site.email }}</a>
  <img class="contact-cta-img" src="/img/uploads/get-in-touch.jpg" alt="Illustration of two children talking on a tin-can telephone">
</section>
