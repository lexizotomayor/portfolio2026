---
layout: page.njk
title: Podcasts
permalink: /podcasts/
navActive: /podcasts/
eyebrow: 05 — tune in
headline: podcasts<br><em>tune in</em>
standfirst: Conversations on journalism, caregiving, and everything in between — recorded between newsroom deadlines and hospital shifts.
eleventyExcludeFromCollections: true
---
<div class="eps">
  {# Episode files carry "number" but no "date", so sort on number explicitly. #}
  {% for ep in collections.episodes | sort(attribute="data.number") %}
  <article class="ep">
    <div class="ep__meta">
      <span class="ep__num">episode {{ ep.data.number }}</span>
      {% if ep.data.length %}<span class="ep__len">{{ ep.data.length }}</span>{% endif %}
    </div>
    <h2><a href="{{ ep.url }}">{{ ep.data.title }}</a></h2>
    {% if ep.data.description %}<p>{{ ep.data.description }}</p>{% endif %}
    <a class="btn btn--quiet" href="{{ ep.url }}"><span aria-hidden="true">&#9654;</span> listen</a>
  </article>
  {% endfor %}
</div>

<div class="pagefoot">
  <a class="btn" href="/blog/">blog <span aria-hidden="true">&rarr;</span></a>
  <a class="backlink" href="/">&larr; back home</a>
</div>
