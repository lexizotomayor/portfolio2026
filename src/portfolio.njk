---
layout: page.njk
title: Portfolio
permalink: /portfolio/
navActive: /portfolio/
eyebrow: 06 — selected work
headline: port<em>folio</em>
standfirst: Identity, editorial and web projects — the design side of the desk.
eleventyExcludeFromCollections: true
---
<div class="postlist">
  {% for item in collections.work | sort(attribute="date", reverse=true) %}
  <article class="postitem">
    <p class="postitem__when">{{ item.data.category }}<br><span class="postitem__sub"><time datetime="{{ item.date | htmlDateString }}" title="{{ item.date | dateReadable }}">{{ item.date | timeAgo }}</time></span></p>
    <div>
      <h2><a href="{{ item.url }}">{{ item.data.title }}</a></h2>
      {% if item.data.description %}<p>{{ item.data.description }}</p>{% endif %}
    </div>
  </article>
  {% endfor %}
</div>

<div class="pagefoot">
  <a class="btn" href="/contact/">work with me <span aria-hidden="true">&rarr;</span></a>
  <a class="backlink" href="/">&larr; back home</a>
</div>
